// KiraayaSense — Prisma schema
// PostgreSQL + PostGIS. Run the PostGIS bootstrap in migrations/000_postgis.sql
// (Prisma cannot create extensions or GIST indexes on geography columns natively —
// see the "Unsupported" fields and the raw-SQL migration note at the bottom.)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ────────────────────────────────────────────────────────────────────────────
// Enums
// ────────────────────────────────────────────────────────────────────────────

enum UserRole {
  GUEST // never persisted — represents an unauthenticated request principal
  USER
  MODERATOR
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED // temporary, e.g. pending investigation
  BANNED // permanent, login blocked
}

enum AuthProvider {
  GOOGLE
  PHONE_OTP
  EMAIL_OTP
  PASSWORD
}

enum OtpChannel {
  SMS
  EMAIL
}

// How the reviewer knows the business. Picks the question set (together
// with the business's sub-category) — an employee and a customer of the
// same company are asked different questions.
enum Relationship {
  TENANT_GUEST
  CUSTOMER
  EMPLOYEE
  STUDENT_PARENT
  PATIENT_FAMILY
  VENDOR_SUPPLIER
  JOB_APPLICANT
}

enum QuestionType {
  STAR // 1–5, scored: feeds the business's rating
  YES_NO
  SINGLE_CHOICE
  NUMBER
}

enum PropertyStatus {
  PENDING_VERIFICATION
  APPROVED
  REJECTED
  MERGED
  UNPUBLISHED // taken down post-approval (legal/moderation action)
}

enum ClaimStatus {
  UNCLAIMED
  PENDING_VERIFICATION
  VERIFIED
  REVOKED
}

enum ReviewStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
  SUSPENDED // approved, then suspended pending re-moderation after flags
}

enum ReasonType {
  PRO
  CON
}

enum MediaKind {
  PHOTO
  VIDEO
}

enum MediaStatus {
  PENDING
  APPROVED
  REJECTED
  REDACTED
}

enum ProofType {
  UPI_TRANSACTION
  RENT_RECEIPT
  BANK_STATEMENT
  INVOICE_RECEIPT
  OTHER_DOCUMENT
}

enum ProofStatus {
  PENDING
  AUTO_REDACTED
  MANUALLY_REDACTED
  APPROVED
  REJECTED
}

enum RedactionMethod {
  NONE
  AUTO
  MANUAL
  AUTO_PLUS_MANUAL
}

enum FlagResolution {
  OPEN
  UPHELD // review stays suspended / gets rejected
  DISMISSED
}

enum OwnerResponseStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
}

enum BannerPlacement {
  HOME_HERO
  LOCALITY_PAGE
  SEARCH_INTERSTITIAL
}

enum BannerStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
}

enum BannerEventType {
  IMPRESSION
  CLICK
}

enum ExportType {
  PROPERTIES
  ENGAGEMENT
  MODERATION_THROUGHPUT
}

enum ExportStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

// ────────────────────────────────────────────────────────────────────────────
// Identity & Access
// ────────────────────────────────────────────────────────────────────────────

enum ProfileVisibility {
  PUBLIC // profile page and name on reviews are visible
  PRIVATE // reviews show only an initial; /u/<handle> returns 404
}

model User {
  id                     String            @id @default(uuid()) @db.Uuid
  displayName            String
  handle                 String?           @unique // public profile URL: /u/<handle>
  city                   String?
  bio                    String?
  profileVisibility      ProfileVisibility @default(PUBLIC)
  avatarStorageKey       String?
  primaryEmail           String?           @unique
  primaryEmailVerifiedAt DateTime?
  primaryPhone           String?           @unique // E.164, e.g. +91XXXXXXXXXX
  primaryPhoneVerifiedAt DateTime?
  alternateEmail         String?
  alternatePhone         String?
  passwordHash           String? // only set if the user opts into password auth
  role                   UserRole          @default(USER)
  status                 UserStatus        @default(ACTIVE)
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  accounts            Account[]
  sessions            Session[]
  submittedProperties Property[]      @relation("PropertySubmitter")
  claimedProperties   Property[]      @relation("PropertyClaimant")
  reviews             Review[]
  reviewFlags         ReviewFlag[]
  ownerResponses      OwnerResponse[]
  createdBanners      AdBanner[]
  auditLogEntries     AuditLog[]      @relation("AuditActor")
  exportJobs          ExportJob[]

  @@index([role, status])
  @@map("users")
}

// OAuth-linked identities (Google, and future providers). One User can have
// multiple Accounts; matching on (provider, providerAccountId), never on email.
model Account {
  id                String       @id @default(uuid()) @db.Uuid
  userId            String       @db.Uuid
  provider          AuthProvider
  providerAccountId String // Google `sub` claim, or phone/email for OTP-based "accounts"
  accessToken       String?
  refreshToken      String?
  expiresAt         DateTime?
  createdAt         DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @db.Uuid
  sessionToken String   @unique
  ipAddress    String?
  userAgent    String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

// Short-lived OTP challenges for phone/email auth. Codes are hashed at rest;
// never store the raw OTP.
model OtpChallenge {
  id          String     @id @default(uuid()) @db.Uuid
  destination String // phone (E.164) or email
  channel     OtpChannel
  codeHash    String
  attempts    Int        @default(0)
  maxAttempts Int        @default(3)
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime   @default(now())

  @@index([destination, channel])
  @@map("otp_challenges")
}

// ────────────────────────────────────────────────────────────────────────────
// Geography reference data
// ────────────────────────────────────────────────────────────────────────────

// Curated locality/PIN reference table used for autocomplete fallback and
// fuzzy "did you mean" suggestions when a search yields no direct hits.
model Locality {
  id       String @id @default(uuid()) @db.Uuid
  name     String
  district String
  state    String
  pincode  String

  properties Property[]

  @@unique([name, district, pincode])
  @@index([pincode])
  @@index([state, district])
  @@map("localities")
}

// ────────────────────────────────────────────────────────────────────────────
// Categories & question sets
// ────────────────────────────────────────────────────────────────────────────

// Two-level tree today (category → sub-category); parentId allows a third
// level later without a schema change. Rows, not an enum, so admins can add
// categories from the console without a release.
model Category {
  id            String         @id @default(uuid()) @db.Uuid
  slug          String         @unique
  name          String
  parentId      String?        @db.Uuid
  sortOrder     Int            @default(0)
  isActive      Boolean        @default(true)
  // Relationships a reviewer can pick for businesses in this category.
  // Read from the top-level category; sub-categories inherit it.
  relationships Relationship[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  parent       Category?     @relation("CategoryTree", fields: [parentId], references: [id])
  children     Category[]    @relation("CategoryTree")
  properties   Property[]
  questionSets QuestionSet[]

  @@index([parentId, sortOrder])
  @@map("categories")
}

// The questions asked for one (category, relationship) pair. categoryId may
// point at a sub-category, a top-level category (fallback for all its
// sub-categories) or be null (generic fallback for the relationship).
// Versioned: editing a set publishes a new version and deactivates the old
// one, and every review keeps the version it answered.
model QuestionSet {
  id            String       @id @default(uuid()) @db.Uuid
  categoryId    String?      @db.Uuid
  relationship  Relationship
  version       Int          @default(1)
  title         String
  isActive      Boolean      @default(true)
  // Housing keeps v1's mandatory proof-of-stay; elsewhere proof is optional
  // and only earns the "verified" badge.
  proofRequired Boolean      @default(false)
  mediaRequired Boolean      @default(false)
  createdAt     DateTime     @default(now())

  category  Category?  @relation(fields: [categoryId], references: [id])
  questions Question[]
  reviews   Review[]

  @@unique([categoryId, relationship, version])
  @@index([relationship, isActive])
  @@map("question_sets")
}

model Question {
  id            String       @id @default(uuid()) @db.Uuid
  questionSetId String       @db.Uuid
  // Stable metric key shared across sets and versions (e.g. VALUE_FOR_MONEY)
  // — ratings aggregate per key, so the same key must mean the same thing
  // wherever it's used.
  key           String
  label         String
  helpText      String?
  type          QuestionType
  options       String[] // SINGLE_CHOICE only
  required      Boolean      @default(true)
  sortOrder     Int          @default(0)

  questionSet QuestionSet    @relation(fields: [questionSetId], references: [id], onDelete: Cascade)
  answers     ReviewAnswer[]

  @@unique([questionSetId, key])
  @@map("questions")
}

// ────────────────────────────────────────────────────────────────────────────
// Properties (shown to users as "businesses": any service business, not
// only housing — the model name is kept to avoid churn in routes and code)
// ────────────────────────────────────────────────────────────────────────────

model Property {
  id         String         @id @default(uuid()) @db.Uuid
  name       String
  categoryId String         @db.Uuid // a sub-category
  status     PropertyStatus @default(PENDING_VERIFICATION)

  doorNumber String?
  street     String?
  localityId String  @db.Uuid
  district   String
  state      String
  pincode    String

  googleMapsUrl String?
  googlePlaceId String?
  // PostGIS geography point (lng, lat). Prisma models it as Unsupported —
  // see migrations/000_postgis.sql for the actual column + GIST index DDL.
  location      Unsupported("geography(Point, 4326)")?

  approxRentMin Int?
  approxRentMax Int?
  unitCount     Int?

  ownerContactPhone String? // private; verification outreach only, never public

  submittedById        String      @db.Uuid
  claimedByUserId      String?     @db.Uuid
  claimStatus          ClaimStatus @default(UNCLAIMED)
  mergedIntoPropertyId String?     @db.Uuid

  rejectionReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  category         Category   @relation(fields: [categoryId], references: [id])
  submittedBy      User       @relation("PropertySubmitter", fields: [submittedById], references: [id])
  claimedBy        User?      @relation("PropertyClaimant", fields: [claimedByUserId], references: [id])
  locality         Locality   @relation(fields: [localityId], references: [id])
  mergedInto       Property?  @relation("PropertyMerge", fields: [mergedIntoPropertyId], references: [id])
  mergedDuplicates Property[] @relation("PropertyMerge")
  reviews          Review[]

  @@index([status, categoryId])
  @@index([pincode])
  @@index([localityId])
  @@map("properties")
}

// ────────────────────────────────────────────────────────────────────────────
// Reviews
// ────────────────────────────────────────────────────────────────────────────

model Review {
  id         String       @id @default(uuid()) @db.Uuid
  propertyId String       @db.Uuid
  userId     String       @db.Uuid
  status     ReviewStatus @default(PENDING_REVIEW)

  relationship  Relationship
  questionSetId String       @db.Uuid
  isAnonymous   Boolean      @default(false)

  stayStartApprox DateTime? @db.Date
  stayEndApprox   DateTime? @db.Date

  rejectionReason String?
  moderatedById   String?   @db.Uuid
  moderatedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  property      Property            @relation(fields: [propertyId], references: [id])
  user          User                @relation(fields: [userId], references: [id])
  questionSet   QuestionSet         @relation(fields: [questionSetId], references: [id])
  answers       ReviewAnswer[]
  reasons       ReviewReason[]
  media         ReviewMedia[]
  proofs        VerificationProof[]
  flags         ReviewFlag[]
  ownerResponse OwnerResponse?

  // One review per user per property within a cooldown window; enforced at
  // the application layer (180-day rule, FR-REV edge cases) since Postgres
  // can't express a time-windowed uniqueness constraint declaratively.
  @@index([propertyId, status])
  @@index([userId])
  @@map("reviews")
}

// One row per answered question. Exactly one value column is set, matching
// the question's type; questionKey is copied from the question so ratings
// can aggregate per key without joining through versions.
model ReviewAnswer {
  id          String   @id @default(uuid()) @db.Uuid
  reviewId    String   @db.Uuid
  questionId  String   @db.Uuid
  questionKey String
  starValue   Int? // 1–5, CHECK constraint in the init migration
  boolValue   Boolean?
  choiceValue String?
  numberValue Float?

  review   Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id])

  @@unique([reviewId, questionId])
  @@index([questionKey])
  @@map("review_answers")
}

model ReviewReason {
  id          String     @id @default(uuid()) @db.Uuid
  reviewId    String     @db.Uuid
  type        ReasonType
  questionKey String // links the pro/con to one of the set's STAR questions
  text        String // min 20 chars, enforced at the API layer (zod) + DB CHECK

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([reviewId])
  @@map("review_reasons")
}

model ReviewMedia {
  id           String      @id @default(uuid()) @db.Uuid
  reviewId     String      @db.Uuid
  kind         MediaKind
  status       MediaStatus @default(PENDING)
  storageKey   String // object storage key (S3/R2)
  thumbnailKey String?
  mimeType     String
  widthPx      Int?
  heightPx     Int?
  durationSec  Int?
  byteSize     Int
  createdAt    DateTime    @default(now())

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([reviewId, status])
  @@map("review_media")
}

model VerificationProof {
  id                 String          @id @default(uuid()) @db.Uuid
  reviewId           String          @db.Uuid
  proofType          ProofType
  status             ProofStatus     @default(PENDING)
  redactionMethod    RedactionMethod @default(NONE)
  // Unredacted original — restricted storage prefix, never selected in any
  // public-facing query. See ERD.md design notes.
  storageKey         String
  // Public-safe, redacted derivative. Null until redaction completes.
  redactedStorageKey String?
  mimeType           String
  byteSize           Int
  consentedAt        DateTime // DPDP consent capture timestamp (FR-REV-4/§14)
  createdAt          DateTime        @default(now())

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([reviewId, status])
  @@map("verification_proofs")
}

model ReviewFlag {
  id              String         @id @default(uuid()) @db.Uuid
  reviewId        String         @db.Uuid
  flaggedByUserId String         @db.Uuid
  reason          String
  resolution      FlagResolution @default(OPEN)
  resolvedAt      DateTime?
  createdAt       DateTime       @default(now())

  review        Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  flaggedByUser User   @relation(fields: [flaggedByUserId], references: [id])

  @@unique([reviewId, flaggedByUserId])
  @@index([reviewId, resolution])
  @@map("review_flags")
}

model OwnerResponse {
  id                String              @id @default(uuid()) @db.Uuid
  reviewId          String              @unique @db.Uuid // one response per review
  respondedByUserId String              @db.Uuid
  text              String // max 1000 chars, enforced at API layer
  status            OwnerResponseStatus @default(PENDING_REVIEW)
  createdAt         DateTime            @default(now())

  review          Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  respondedByUser User   @relation(fields: [respondedByUserId], references: [id])

  @@map("owner_responses")
}

// ────────────────────────────────────────────────────────────────────────────
// Monetization
// ────────────────────────────────────────────────────────────────────────────

model AdBanner {
  id                String          @id @default(uuid()) @db.Uuid
  title             String
  imageStorageKey   String
  clickThroughUrl   String
  placement         BannerPlacement
  status            BannerStatus    @default(DRAFT)
  targetImpressions Int
  startAt           DateTime
  endAt             DateTime
  advertiserName    String
  advertiserContact String?
  createdById       String          @db.Uuid
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  createdBy User          @relation(fields: [createdById], references: [id])
  events    BannerEvent[]

  @@index([placement, status])
  @@map("ad_banners")
}

// High-write-volume table; partition by month in production (see
// implementation plan §"Data lifecycle & partitioning").
model BannerEvent {
  id        String          @id @default(uuid()) @db.Uuid
  bannerId  String          @db.Uuid
  eventType BannerEventType
  sessionId String
  userId    String?         @db.Uuid
  createdAt DateTime        @default(now())

  banner AdBanner @relation(fields: [bannerId], references: [id], onDelete: Cascade)

  @@index([bannerId, eventType, createdAt])
  @@map("banner_events")
}

// ────────────────────────────────────────────────────────────────────────────
// Platform: audit & reporting
// ────────────────────────────────────────────────────────────────────────────

// Polymorphic, intentionally without a hard FK on (entityType, entityId) —
// must outlive redaction/erasure of the entity it describes. See ERD.md.
model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  actorUserId String   @db.Uuid
  action      String // e.g. "PROPERTY_APPROVED", "ROLE_CHANGED", "REVIEW_REDACTED"
  entityType  String
  entityId    String   @db.Uuid
  metadata    Json?
  createdAt   DateTime @default(now())

  actor User @relation("AuditActor", fields: [actorUserId], references: [id])

  @@index([entityType, entityId])
  @@index([actorUserId, createdAt])
  @@map("audit_logs")
}

model ExportJob {
  id                String       @id @default(uuid()) @db.Uuid
  requestedByUserId String       @db.Uuid
  type              ExportType
  status            ExportStatus @default(PENDING)
  fileStorageKey    String?
  errorMessage      String?
  requestedAt       DateTime     @default(now())
  completedAt       DateTime?

  requestedByUser User @relation(fields: [requestedByUserId], references: [id])

  @@index([requestedByUserId, status])
  @@map("export_jobs")
}

// ────────────────────────────────────────────────────────────────────────────
// Raw SQL Prisma can't express (PostGIS/pg_trgm extensions, GIST/GIN
// indexes, CHECK constraints, the aggregates view) lives in the migration
// files under prisma/migrations — see 0001_init/migration.sql.
// ────────────────────────────────────────────────────────────────────────────
