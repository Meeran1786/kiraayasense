// KiraayaSense — Prisma schema
// PostgreSQL + PostGIS. Run the PostGIS bootstrap in migrations/000_postgis.sql
// (Prisma cannot create extensions or GIST indexes on geography columns natively —
// see the "Unsupported" fields and the raw-SQL migration note at the bottom.)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ────────────────────────────────────────────────────────────────────────────
// Enums
// ────────────────────────────────────────────────────────────────────────────

enum UserRole {
  GUEST // never persisted — represents an unauthenticated request principal
  USER
  MODERATOR
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED // temporary, e.g. pending investigation
  BANNED // permanent, login blocked
}

enum AuthProvider {
  GOOGLE
  PHONE_OTP
  EMAIL_OTP
  PASSWORD
}

enum OtpChannel {
  SMS
  EMAIL
}

enum PropertyCategory {
  FLAT
  INDEPENDENT_HOUSE
  PG
  HOSTEL
  HOTEL_BUDGET
  HOTEL_LUXURY
}

enum PropertyStatus {
  PENDING_VERIFICATION
  APPROVED
  REJECTED
  MERGED
  UNPUBLISHED // taken down post-approval (legal/moderation action)
}

enum ClaimStatus {
  UNCLAIMED
  PENDING_VERIFICATION
  VERIFIED
  REVOKED
}

enum ReviewStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
  SUSPENDED // approved, then suspended pending re-moderation after flags
}

enum GrievanceCategory {
  VALUE_FOR_MONEY
  LOCALITY_SAFETY
  OWNER_RESPONSIVENESS
  HYGIENE_CLEANLINESS
  WATER_SUPPLY
  ELECTRICITY_BACKUP
  AMENITIES_LIFT
}

enum ReasonType {
  PRO
  CON
}

enum MediaKind {
  PHOTO
  VIDEO
}

enum MediaStatus {
  PENDING
  APPROVED
  REJECTED
  REDACTED
}

enum ProofType {
  UPI_TRANSACTION
  RENT_RECEIPT
  BANK_STATEMENT
}

enum ProofStatus {
  PENDING
  AUTO_REDACTED
  MANUALLY_REDACTED
  APPROVED
  REJECTED
}

enum RedactionMethod {
  NONE
  AUTO
  MANUAL
  AUTO_PLUS_MANUAL
}

enum FlagResolution {
  OPEN
  UPHELD // review stays suspended / gets rejected
  DISMISSED
}

enum OwnerResponseStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
}

enum BannerPlacement {
  HOME_HERO
  LOCALITY_PAGE
  SEARCH_INTERSTITIAL
}

enum BannerStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
}

enum BannerEventType {
  IMPRESSION
  CLICK
}

enum ExportType {
  PROPERTIES
  ENGAGEMENT
  MODERATION_THROUGHPUT
}

enum ExportStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

// ────────────────────────────────────────────────────────────────────────────
// Identity & Access
// ────────────────────────────────────────────────────────────────────────────

model User {
  id                     String     @id @default(uuid()) @db.Uuid
  displayName            String
  avatarStorageKey        String?
  primaryEmail           String?    @unique
  primaryEmailVerifiedAt DateTime?
  primaryPhone           String?    @unique // E.164, e.g. +91XXXXXXXXXX
  primaryPhoneVerifiedAt DateTime?
  alternateEmail         String?
  alternatePhone         String?
  passwordHash           String? // only set if the user opts into password auth
  role                   UserRole   @default(USER)
  status                 UserStatus @default(ACTIVE)
  createdAt              DateTime   @default(now())
  updatedAt              DateTime   @updatedAt

  accounts          Account[]
  sessions          Session[]
  submittedProperties Property[]       @relation("PropertySubmitter")
  claimedProperties Property[]         @relation("PropertyClaimant")
  reviews           Review[]
  reviewFlags       ReviewFlag[]
  ownerResponses    OwnerResponse[]
  createdBanners    AdBanner[]
  auditLogEntries   AuditLog[]         @relation("AuditActor")
  exportJobs        ExportJob[]

  @@index([role, status])
  @@map("users")
}

// OAuth-linked identities (Google, and future providers). One User can have
// multiple Accounts; matching on (provider, providerAccountId), never on email.
model Account {
  id                String       @id @default(uuid()) @db.Uuid
  userId            String       @db.Uuid
  provider          AuthProvider
  providerAccountId String // Google `sub` claim, or phone/email for OTP-based "accounts"
  accessToken       String?
  refreshToken      String?
  expiresAt         DateTime?
  createdAt         DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @db.Uuid
  sessionToken String   @unique
  ipAddress    String?
  userAgent    String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

// Short-lived OTP challenges for phone/email auth. Codes are hashed at rest;
// never store the raw OTP.
model OtpChallenge {
  id          String     @id @default(uuid()) @db.Uuid
  destination String // phone (E.164) or email
  channel     OtpChannel
  codeHash    String
  attempts    Int        @default(0)
  maxAttempts Int        @default(3)
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime   @default(now())

  @@index([destination, channel])
  @@map("otp_challenges")
}

// ────────────────────────────────────────────────────────────────────────────
// Geography reference data
// ────────────────────────────────────────────────────────────────────────────

// Curated locality/PIN reference table used for autocomplete fallback and
// fuzzy "did you mean" suggestions when a search yields no direct hits.
model Locality {
  id       String  @id @default(uuid()) @db.Uuid
  name     String
  district String
  state    String
  pincode  String

  properties Property[]

  @@unique([name, district, pincode])
  @@index([pincode])
  @@index([state, district])
  @@map("localities")
}

// ────────────────────────────────────────────────────────────────────────────
// Properties
// ────────────────────────────────────────────────────────────────────────────

model Property {
  id         String            @id @default(uuid()) @db.Uuid
  name       String
  category   PropertyCategory
  status     PropertyStatus    @default(PENDING_VERIFICATION)

  doorNumber String
  street     String
  localityId String            @db.Uuid
  district   String
  state      String
  pincode    String

  googleMapsUrl String?
  googlePlaceId String?
  // PostGIS geography point (lng, lat). Prisma models it as Unsupported —
  // see migrations/000_postgis.sql for the actual column + GIST index DDL.
  location   Unsupported("geography(Point, 4326)")?

  approxRentMin Int?
  approxRentMax Int?
  unitCount     Int?

  ownerContactPhone String? // private; verification outreach only, never public

  submittedById        String        @db.Uuid
  claimedByUserId       String?       @db.Uuid
  claimStatus           ClaimStatus   @default(UNCLAIMED)
  mergedIntoPropertyId  String?       @db.Uuid

  rejectionReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  submittedBy      User       @relation("PropertySubmitter", fields: [submittedById], references: [id])
  claimedBy        User?      @relation("PropertyClaimant", fields: [claimedByUserId], references: [id])
  locality         Locality   @relation(fields: [localityId], references: [id])
  mergedInto       Property?  @relation("PropertyMerge", fields: [mergedIntoPropertyId], references: [id])
  mergedDuplicates Property[] @relation("PropertyMerge")
  reviews          Review[]

  @@index([status, category])
  @@index([pincode])
  @@index([localityId])
  @@map("properties")
}

// ────────────────────────────────────────────────────────────────────────────
// Reviews
// ────────────────────────────────────────────────────────────────────────────

model Review {
  id         String       @id @default(uuid()) @db.Uuid
  propertyId String       @db.Uuid
  userId     String       @db.Uuid
  status     ReviewStatus @default(PENDING_REVIEW)

  stayStartApprox DateTime? @db.Date
  stayEndApprox   DateTime? @db.Date

  rejectionReason String?
  moderatedById   String?   @db.Uuid
  moderatedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  property        Property                @relation(fields: [propertyId], references: [id])
  user            User                    @relation(fields: [userId], references: [id])
  categoryScores  ReviewCategoryScore[]
  reasons         ReviewReason[]
  media           ReviewMedia[]
  proofs          VerificationProof[]
  flags           ReviewFlag[]
  ownerResponse   OwnerResponse?

  // One review per user per property within a cooldown window; enforced at
  // the application layer (180-day rule, FR-REV edge cases) since Postgres
  // can't express a time-windowed uniqueness constraint declaratively.
  @@index([propertyId, status])
  @@index([userId])
  @@map("reviews")
}

model ReviewCategoryScore {
  id       String            @id @default(uuid()) @db.Uuid
  reviewId String            @db.Uuid
  category GrievanceCategory
  score    Int // 1–5, enforced by a CHECK constraint (migrations/001_checks.sql)

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@unique([reviewId, category])
  @@map("review_category_scores")
}

model ReviewReason {
  id       String            @id @default(uuid()) @db.Uuid
  reviewId String            @db.Uuid
  type     ReasonType
  category GrievanceCategory
  text     String // min 20 chars, enforced at the API layer (zod) + DB CHECK

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([reviewId])
  @@map("review_reasons")
}

model ReviewMedia {
  id             String      @id @default(uuid()) @db.Uuid
  reviewId       String      @db.Uuid
  kind           MediaKind
  status         MediaStatus @default(PENDING)
  storageKey     String // object storage key (S3/R2)
  thumbnailKey   String?
  mimeType       String
  widthPx        Int?
  heightPx       Int?
  durationSec    Int?
  byteSize       Int
  createdAt      DateTime    @default(now())

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([reviewId, status])
  @@map("review_media")
}

model VerificationProof {
  id                 String          @id @default(uuid()) @db.Uuid
  reviewId           String          @db.Uuid
  proofType          ProofType
  status             ProofStatus     @default(PENDING)
  redactionMethod    RedactionMethod @default(NONE)
  // Unredacted original — restricted storage prefix, never selected in any
  // public-facing query. See ERD.md design notes.
  storageKey         String
  // Public-safe, redacted derivative. Null until redaction completes.
  redactedStorageKey String?
  mimeType           String
  byteSize           Int
  consentedAt        DateTime // DPDP consent capture timestamp (FR-REV-4/§14)
  createdAt          DateTime        @default(now())

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([reviewId, status])
  @@map("verification_proofs")
}

model ReviewFlag {
  id             String         @id @default(uuid()) @db.Uuid
  reviewId       String         @db.Uuid
  flaggedByUserId String        @db.Uuid
  reason         String
  resolution     FlagResolution @default(OPEN)
  resolvedAt     DateTime?
  createdAt      DateTime       @default(now())

  review        Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  flaggedByUser User   @relation(fields: [flaggedByUserId], references: [id])

  @@unique([reviewId, flaggedByUserId])
  @@index([reviewId, resolution])
  @@map("review_flags")
}

model OwnerResponse {
  id                String              @id @default(uuid()) @db.Uuid
  reviewId          String              @unique @db.Uuid // one response per review
  respondedByUserId String              @db.Uuid
  text              String // max 1000 chars, enforced at API layer
  status            OwnerResponseStatus @default(PENDING_REVIEW)
  createdAt         DateTime            @default(now())

  review         Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  respondedByUser User  @relation(fields: [respondedByUserId], references: [id])

  @@map("owner_responses")
}

// ────────────────────────────────────────────────────────────────────────────
// Monetization
// ────────────────────────────────────────────────────────────────────────────

model AdBanner {
  id                String          @id @default(uuid()) @db.Uuid
  title             String
  imageStorageKey   String
  clickThroughUrl   String
  placement         BannerPlacement
  status            BannerStatus    @default(DRAFT)
  targetImpressions Int
  startAt           DateTime
  endAt             DateTime
  advertiserName    String
  advertiserContact String?
  createdById       String          @db.Uuid
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  createdBy User          @relation(fields: [createdById], references: [id])
  events    BannerEvent[]

  @@index([placement, status])
  @@map("ad_banners")
}

// High-write-volume table; partition by month in production (see
// implementation plan §"Data lifecycle & partitioning").
model BannerEvent {
  id        String          @id @default(uuid()) @db.Uuid
  bannerId  String          @db.Uuid
  eventType BannerEventType
  sessionId String
  userId    String?         @db.Uuid
  createdAt DateTime        @default(now())

  banner AdBanner @relation(fields: [bannerId], references: [id], onDelete: Cascade)

  @@index([bannerId, eventType, createdAt])
  @@map("banner_events")
}

// ────────────────────────────────────────────────────────────────────────────
// Platform: audit & reporting
// ────────────────────────────────────────────────────────────────────────────

// Polymorphic, intentionally without a hard FK on (entityType, entityId) —
// must outlive redaction/erasure of the entity it describes. See ERD.md.
model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  actorUserId String   @db.Uuid
  action      String // e.g. "PROPERTY_APPROVED", "ROLE_CHANGED", "REVIEW_REDACTED"
  entityType  String
  entityId    String   @db.Uuid
  metadata    Json?
  createdAt   DateTime @default(now())

  actor User @relation("AuditActor", fields: [actorUserId], references: [id])

  @@index([entityType, entityId])
  @@index([actorUserId, createdAt])
  @@map("audit_logs")
}

model ExportJob {
  id               String       @id @default(uuid()) @db.Uuid
  requestedByUserId String      @db.Uuid
  type             ExportType
  status           ExportStatus @default(PENDING)
  fileStorageKey   String?
  errorMessage     String?
  requestedAt      DateTime     @default(now())
  completedAt      DateTime?

  requestedByUser User @relation(fields: [requestedByUserId], references: [id])

  @@index([requestedByUserId, status])
  @@map("export_jobs")
}

// ────────────────────────────────────────────────────────────────────────────
// NOTE — required raw-SQL follow-up migrations (Prisma limitations):
//
// 1. migrations/000_postgis.sql
//    CREATE EXTENSION IF NOT EXISTS postgis;
//    CREATE EXTENSION IF NOT EXISTS pg_trgm;
//    CREATE INDEX properties_location_gist
//      ON properties USING GIST (location);
//    CREATE INDEX properties_name_trgm
//      ON properties USING GIN (name gin_trgm_ops);
//    CREATE INDEX localities_name_trgm
//      ON localities USING GIN (name gin_trgm_ops);
//
// 2. migrations/001_checks.sql
//    ALTER TABLE review_category_scores
//      ADD CONSTRAINT score_range CHECK (score BETWEEN 1 AND 5);
//    ALTER TABLE review_reasons
//      ADD CONSTRAINT reason_min_length CHECK (char_length(text) >= 20);
//
// 3. A materialized view `property_rating_aggregates` (property_id, category
//    means, overall mean, approved_review_count), refreshed on review
//    approval/suspension via a Postgres trigger or an application-level job
//    queue hook — see implementation plan §"Aggregate ratings".
// ────────────────────────────────────────────────────────────────────────────
