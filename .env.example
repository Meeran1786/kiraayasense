# Copy this file to .env and fill in real values, then run: npm run db:setup
# .env is gitignored — never commit real secrets here.

# Local Postgres (created by `createdb kiraayasense` / scripts/db-setup.sh).
# Adjust user/password/port to match your local Postgres install.
DATABASE_URL="postgresql://localhost:5432/kiraayasense?schema=public"

# Google OAuth 2.0 client — create one at https://console.cloud.google.com/apis/credentials
#   Application type: Web application
#   Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Optional: Google Places autocomplete on the "Add a business" form (billed per request).
GOOGLE_PLACES_API_KEY=""
# Optional: Overpass API mirror for OpenStreetMap imports.
# OVERPASS_URL="https://overpass-api.de/api/interpreter"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""

# Review rewards: set to true to show the monthly cash pool and UPI withdrawal on /profile/rewards.
REWARDS_CASH_ENABLED=false

# Optional: machine translation for the "Translate" button on reviews. Set one.
# Microsoft Azure AI Translator (free F0 tier: 2M characters/month). Region is
# the resource's location, e.g. centralindia; leave empty for a global resource.
AZURE_TRANSLATOR_KEY=""
AZURE_TRANSLATOR_REGION=""
# Or Google Cloud Translation Basic (v2) API key (500k characters/month free).
# GOOGLE_TRANSLATE_API_KEY=""
# With neither set, the button opens the review in Google Translate instead.

# Ask KiraayaSense (AI assistant). Hidden until ANTHROPIC_API_KEY is set.
# Get a key at https://console.anthropic.com and set a monthly spend limit there too.
ANTHROPIC_API_KEY=""
# claude-haiku-5-5 (default, cheapest), claude-sonnet-5-5 or claude-opus-5-5
ASSISTANT_MODEL="claude-haiku-5-5"
# Questions per signed-in user per day, and the site-wide daily spend cap in US dollars.
ASSISTANT_DAILY_QUESTIONS=20
ASSISTANT_DAILY_BUDGET_USD=5

# Alerts. Every alert shows on the in-site bell; email and WhatsApp are optional.
# Email through Resend (https://resend.com). Verify the kiraayasense.com domain there
# (add its DNS records at GoDaddy) so mail can come from alerts@kiraayasense.com.
RESEND_API_KEY=""
ALERTS_FROM_EMAIL="KiraayaSense <alerts@kiraayasense.com>"
# WhatsApp through Meta's WhatsApp Business Cloud API. The number must not already be
# on the WhatsApp app. Templates to submit are listed in deploy/WHATSAPP_TEMPLATES.md.
WHATSAPP_PHONE_NUMBER_ID=""
# A permanent System User token with whatsapp_business_messaging permission.
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_TEMPLATE_LANG="en"
WHATSAPP_OTP_TEMPLATE="ks_verify_code"
# Protects /api/cron/daily-alerts (the 9 AM summary). deploy.sh creates it on the server.
CRON_SECRET=""
